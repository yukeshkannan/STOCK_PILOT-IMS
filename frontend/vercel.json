{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://stockpilot-ims.duckdns.org/api/:path*"
    },
    {
      "source": "/health",
      "destination": "http://stockpilot-ims.duckdns.org/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
