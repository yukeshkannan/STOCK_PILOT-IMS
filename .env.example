# ==========================================
# StockPilot Microservices SaaS Configuration
# ==========================================

NODE_ENV=development
JWT_SECRET=stockpilot_super_secret_jwt_key_2026
JWT_REFRESH_SECRET=stockpilot_refresh_secret_key_2026
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# Database Configuration (MySQL / SQLite)
DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=rootpassword
DB_LOGGING=false

# RabbitMQ Event Bus
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Service Ports & URLs (API Gateway routing)
AUTH_SERVICE_URL=http://localhost:5001
TENANT_SERVICE_URL=http://localhost:5002
PRODUCT_SERVICE_URL=http://localhost:5003
INVENTORY_SERVICE_URL=http://localhost:5004
WAREHOUSE_SERVICE_URL=http://localhost:5005
PURCHASE_SERVICE_URL=http://localhost:5006
SALES_SERVICE_URL=http://localhost:5007
FINANCE_SERVICE_URL=http://localhost:5008
NOTIFICATION_SERVICE_URL=http://localhost:5009
