# ==========================================
# StockPilot Microservices SaaS Configuration
# ==========================================

NODE_ENV=production
# Generate high-entropy 256-bit secrets via: node scripts/generate-secrets.js --apply
JWT_SECRET=your_production_64_character_hex_jwt_secret_here
JWT_REFRESH_SECRET=your_production_64_character_hex_refresh_secret_here
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# Super Admin Provisioning (Auto-provisioned on clean boot)
SUPERADMIN_EMAIL=superadmin@stockpilot.io
SUPERADMIN_PASSWORD=your_strong_production_superadmin_password_min_14_chars
SUPERADMIN_FIRST_NAME=Super
SUPERADMIN_LAST_NAME=Admin

# Database Configuration (MySQL 8.0 / Percona)
DB_DIALECT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=stockpilot_user
DB_PASSWORD=your_strong_mysql_database_password
DB_LOGGING=false
# Dynamic Connection Pool Limits (Tune per service profile)
DB_POOL_MAX=20
DB_POOL_MIN=5

# RabbitMQ Event Bus (Local or CloudAMQP)
RABBITMQ_URL=amqp://stockpilot_user:your_rabbitmq_password@127.0.0.1:5672

# Service Ports & URLs (API Gateway routing)
AUTH_SERVICE_URL=http://localhost:5001
TENANT_SERVICE_URL=http://localhost:5002
PRODUCT_SERVICE_URL=http://localhost:5003
INVENTORY_SERVICE_URL=http://localhost:5004
WAREHOUSE_SERVICE_URL=http://localhost:5005
PURCHASE_SERVICE_URL=http://localhost:5006
SALES_SERVICE_URL=http://localhost:5007
FINANCE_SERVICE_URL=http://localhost:5008
NOTIFICATION_SERVICE_URL=http://localhost:5009

# Brevo (Sendinblue) Transactional Email Gateway
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=yukesh785.in@gmail.com
BREVO_SENDER_NAME=StockPilot Orders

